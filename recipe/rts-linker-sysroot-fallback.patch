+               resolve it through its usual search order. */
+            if (r == NULL && strchr(line+match[2].rm_so, '/') != NULL) {
+               char *base = strrchr(line+match[2].rm_so, '/') + 1;
+               stgFree((void*)*errmsg);
+               r = loadNativeObj_POSIX(base, errmsg);
+            }
